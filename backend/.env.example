# One-time: creates your first admin login on next startup if the admins
# table is empty. Safe to leave blank after that first run — the seeder
# only acts when both are set AND no admin exists yet, so leaving these
# filled in does nothing on later restarts once you have an admin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=